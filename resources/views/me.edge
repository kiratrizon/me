      <form id="contactForm" class="reveal gradient-border rounded-3xl bg-gray-900/70 backdrop-blur p-6 sm:p-8 space-y-5" style="--delay:150ms">
        <div>
          <label for="cf-name" class="block text-sm text-gray-400 mb-2">Company / Name</label>
          <input
            id="cf-name"
            type="text"
            name="name"
            placeholder="Acme Inc. / Jane Doe"
            class="w-full px-4 py-3 bg-gray-950/80 border border-white/10 rounded-xl placeholder-gray-600 focus:outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-500/20 transition"
            required
          />
        </div>
        <div>
          <label for="cf-email" class="block text-sm text-gray-400 mb-2">Email</label>
          <input
            id="cf-email"
            type="email"
            name="email"
            placeholder="you@company.com"
            class="w-full px-4 py-3 bg-gray-950/80 border border-white/10 rounded-xl placeholder-gray-600 focus:outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-500/20 transition"
            required
          />
        </div>
        <div>
          <label for="cf-message" class="block text-sm text-gray-400 mb-2">Message</label>
          <textarea
            id="cf-message"
            name="message"
            placeholder="Tell me about the role or project..."
            rows="5"
            class="w-full px-4 py-3 bg-gray-950/80 border border-white/10 rounded-xl placeholder-gray-600 focus:outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-500/20 transition resize-none"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn-shine w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl font-semibold bg-gradient-to-r from-indigo-500 to-fuchsia-500 hover:shadow-lg hover:shadow-indigo-500/30 disabled:opacity-60 transition"
        >
          <i class="fa-solid fa-paper-plane"></i> <span>Send Message</span>
        </button>

        <!-- Success / Error message -->
        <p id="formMessage" class="text-sm font-medium hidden"></p>
      </form>
    </div>
  </section>

